diff --git a/frontend/moran-app.js b/frontend/moran-app.js
index 3c5521a..85fd64a 100644
--- a/frontend/moran-app.js
+++ b/frontend/moran-app.js
@@ -1021,0 +1022,21 @@
+  // ---- MoranBuy entry at the right-hand side of the header (github.com/tito-devsec/moranbuy) ----
+  // One link on every page, before the notification bell, to the MoranBuy business app, where the
+  // owner lists products on the reverse marketplace, runs campaigns and follow-up. Shown only when
+  // MORANBUY_URL is set in config.js; the server decides what the owner may do there.
+  function mountMoranBuyEntry(attempt = 0) {
+    const url = CFG.MORANBUY_URL;
+    if (!url || document.getElementById('moranBuyEntry')) return;
+    const bell = document.querySelector('header [x-data*="notificationBell"]');
+    if (!bell) { if (attempt < 20) setTimeout(() => mountMoranBuyEntry(attempt + 1), 150); return; }
+    const a = document.createElement('a');
+    a.id = 'moranBuyEntry';
+    a.href = `${String(url).replace(/\/+$/, '')}/business/`;
+    a.target = '_blank';
+    a.rel = 'noopener';
+    a.title = 'MoranBuy: list your products on the reverse marketplace';
+    a.className = 'hidden sm:inline-flex items-center gap-1 rounded-lg border border-gray-200 px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-800 dark:text-gray-300 mr-2';
+    a.textContent = 'MoranBuy';
+    bell.parentElement.insertBefore(a, bell);
+  }
+  document.addEventListener('DOMContentLoaded', () => mountMoranBuyEntry());
+
