# MoranBuy production .env for buy.moranai.co.tz (copy to the repository root as .env on the VPS).
APP_ENV=production
APP_URL=https://buy.moranai.co.tz
PORT=4000
LOG_LEVEL=info
DB_PASSWORD=CHANGE_ME_long_random

# Generated once: openssl rand -hex 32 (AUTH_SECRET) and openssl rand -hex 32 (ENCRYPTION_KEY, exactly 64 hex chars)
AUTH_SECRET=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_64_hex_chars

# First admin, created by `npm run seed` on first start; change the password after signing in.
ADMIN_BOOTSTRAP_EMAIL=admin@moranai.co.tz
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_12_plus_chars

# The real Moran AI backend on this VPS, and the secret shared with it (same value as MORANBUY_SHARED_SECRET in Moran's .env).
MORAN_BACKEND_BASE_URL=https://api.moranai.co.tz
MORAN_SHARED_SECRET=CHANGE_ME_openssl_rand_hex_32
# Moran's Docker network, which the API joins so Moran's nginx reaches it (docker network ls).
MORAN_DOCKER_NETWORK=moran-backend_default
# Host port for local checks only (Moran's nginx uses the Docker network); 4000 is taken by another service on the Moran VPS.
MORANBUY_HOST_PORT=4100

# Muse Spark, Snippe and Hermes may be left blank here and entered in MoranBuy Admin (Muse Spark Intelligence, Security and Settings).
MUSE_PROVIDER=disabled
MUSE_API_BASE_URL=https://api.meta.ai/v1
MUSE_API_KEY=
MUSE_MODEL_ID=muse-spark-1.3
PAYMENT_PROVIDER=snippe
SNIPPE_API_KEY=
SNIPPE_WEBHOOK_SECRET=
SNIPPE_BASE_URL=https://api.snippe.sh
HERMES_BASE_URL=
HERMES_API_KEY=
MORANBUY_WEB_RESEARCH_ENABLED=false
MORANBUY_ALLOWED_DOMAINS=

# Keep dry-run on until a one-recipient campaign has been checked end to end in production.
CAMPAIGN_DRY_RUN=true
FOLLOWUP_DRY_RUN=true
# Customer schedule reminders ("nitanunua wiki ijayo") are recorded but not sent while true.
REMINDER_DRY_RUN=true
# redis: timed jobs (scheduled campaigns, dispatch, follow-ups, reminders) run from a Redis work list within a second of being due, with Postgres passes every 5 minutes as a safety net; poll: Postgres passes only.
QUEUE_MODE=redis
# The scheduled retention purge only counts expired records while true; set false to delete them (Super Admin can also run it by hand).
RETENTION_DRY_RUN=true
# Where uploaded files are kept (product photos, verification documents, customer photos); a persistent volume in production.
UPLOAD_DIR=/app/data/uploads
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_PDF_MB=10
GEOCODER_CONTACT_EMAIL=admin@moranai.co.tz
DEFAULT_CURRENCY=TZS
DEFAULT_COUNTRY=TZ
